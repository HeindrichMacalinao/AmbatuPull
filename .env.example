# ==============================================================================
# Hope, Inc. ERP — Environment Configuration (Next.js + Supabase + Vercel)
# ==============================================================================
# Copy this file to .env.local before starting:
#   Windows PowerShell: Copy-Item .env.example .env.local
#   Bash:               cp .env.example .env.local
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Cloud Configuration (Find in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct PostgreSQL Connection URI (Supabase -> Project Settings -> Database -> Connection URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Security & Session Settings
SESSION_SECRET=ambatu_development_secret_key_change_in_production_32chars
BCRYPT_ROUNDS=12
TZ=UTC
