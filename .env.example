# Copy this file to .env and fill in real values. Never commit .env.

# Port the HTTP server listens on (integer, 1-65535)
PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_user
DB_PASS=change_me
DB_NAME=erp_db

# Secret used to sign session cookies (min. 16 characters; use a long random string)
SESSION_SECRET=replace_with_a_long_random_string

# Public base URL of this app (must be a valid http/https URL)
APP_URL=http://localhost:3000
