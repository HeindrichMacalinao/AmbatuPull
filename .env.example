# ==============================================================================
# Hope, Inc. ERP — Environment Configuration (Next.js + Supabase + Vercel)
# ==============================================================================
# Copy this file to .env.local before starting:
#   Windows PowerShell: Copy-Item .env.example .env.local
#   Bash:               cp .env.example .env.local
# ==============================================================================

# Application Environment
NODE_ENV=development
# Set to the deployed domain on Vercel (e.g., https://ambatupull-erp.vercel.app), not localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Cloud Configuration (Find in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct PostgreSQL Connection URI (Supabase -> Project Settings -> Database -> Connection URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Password reset email delivery (SMTP)
# For local development: leave unset to log password reset links to console instead of sending email.
# For Vercel production: all SMTP variables below and NEXT_PUBLIC_APP_URL are required.
# Working Gmail SMTP example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-account@gmail.com
#   SMTP_PASSWORD=abcd efgh ijkl mnop (16-character Google App Password)
#   SMTP_FROM="Hope, Inc. ERP" <your-account@gmail.com>
# Note: Vercel requires a manual redeploy after setting or modifying environment variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Security & Session Settings
SESSION_SECRET=ambatu_development_secret_key_change_in_production_32chars
BCRYPT_ROUNDS=12
TZ=UTC
