# ==============================================================================
# Hope, Inc. ERP — Environment Configuration
# ==============================================================================
# Copy this file to .env before starting:
#   Windows PowerShell: Copy-Item .env.example .env
#   Bash:               cp .env.example .env
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# SQLite Local Database Setup (Zero Docker Required - Sprint 1 Default)
DB_CLIENT=sqlite
DB_PATH=./data/erp_local.db

# Character Encoding & Timezone Standards
TZ=UTC
DB_ENCODING=UTF-8

# Session & Security Settings (Sprint 1 Auth)
SESSION_SECRET=ambatu_development_secret_key_change_in_production_32chars
BCRYPT_ROUNDS=10

# PostgreSQL Connection (Alternative / Production Database Setup)
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_user
DB_PASS=change_me
DB_NAME=erp_db
