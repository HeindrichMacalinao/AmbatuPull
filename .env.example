# ==============================================================================
# Hope, Inc. ERP — Environment Configuration (Next.js + Supabase + Vercel)
# ==============================================================================
# Copy this file to .env.local before starting:
#   Windows PowerShell: Copy-Item .env.example .env.local
#   Bash:               cp .env.example .env.local
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Cloud Configuration (Find in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct PostgreSQL Connection URI (Supabase -> Project Settings -> Database -> Connection URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ==============================================================================
# Transactional Email Delivery (OTP for Registration & Password Reset)
# ==============================================================================
# Choose either Option A (Resend - Recommended for Vercel) OR Option B (SMTP)

# Option A: Resend API (Get free API key at https://resend.com - 3,000 free emails/mo)
# RESEND_API_KEY=re_123456789abcdef
# EMAIL_FROM=Hope ERP <onboarding@resend.dev>

# Option B: Standard SMTP (Gmail, Brevo, SendGrid, Mailgun, Amazon SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_PASSWORD=your-gmail-app-password
# SMTP_FROM="Hope, Inc. ERP" <your-email@gmail.com>

# Security & Session Settings
SESSION_SECRET=ambatu_development_secret_key_change_in_production_32chars
BCRYPT_ROUNDS=12
TZ=UTC
