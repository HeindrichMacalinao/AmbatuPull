{
  "name": "ambatupull-erp",
  "version": "1.0.0",
  "description": "Hope, Inc. ERP - System Foundation, Backend & Local Database Migration Runner",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate/index.js up",
    "migrate:up": "node scripts/migrate/index.js up",
    "migrate:down": "node scripts/migrate/index.js down",
    "migrate:status": "node scripts/migrate/index.js status",
    "migrate:reset": "node scripts/migrate/index.js reset",
    "db:setup": "node scripts/migrate/index.js up",
    "db:status": "node scripts/migrate/index.js status",
    "db:reset": "node scripts/migrate/index.js reset",
    "test": "python tests/verify_hope.py && python tests/verify_user_management.py && python tests/verify_qa_fixtures.py && python tests/verify_auth_contract.py",
    "test:auth": "node --test tests/auth-flow.test.js",
    "test:user-management": "node --test tests/user-management.test.js"
  },
  "keywords": [
    "sqlite",
    "database-migrations",
    "hope-erp",
    "devsecops",
    "windows-setup",
    "no-docker",
    "express",
    "backend"
  ],
  "author": "Hope, Inc. ERP Team",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
